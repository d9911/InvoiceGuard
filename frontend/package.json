    "express": "^5.2.1",
    "lucide-react": "^1.17.0",
    "motion": "^12.23.24",
    "next": "16.2.7",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
